# Copy to deploy/.env on the deployment host. Never commit the populated file.

# Untagged repositories are stable deployment configuration. deploy-safe.sh
# combines them with its validated git-<12-or-40-character-sha> argument and atomically persists the
# resulting image references below. The Web image must be built with an empty
# VITE_API_URL and production LIFF values. Deployment tooling parses only the
# required keys from this file; never source it or export these values manually.
LINE_QUEUE_API_REPOSITORY=docker.io/trungnghia2703/line-smart-queue-api
LINE_QUEUE_WEB_REPOSITORY=docker.io/trungnghia2703/line-smart-queue-web
LINE_QUEUE_API_IMAGE=docker.io/trungnghia2703/line-smart-queue-api:git-0000000000000000000000000000000000000000
LINE_QUEUE_WEB_IMAGE=docker.io/trungnghia2703/line-smart-queue-web:git-0000000000000000000000000000000000000000

# Public web endpoint exposed by the web/nginx container.
WEB_ORIGIN=https://smartqueue.io.vn
WEB_PORT=80

# PostgreSQL. DATABASE_URL is assembled inside Compose from these values.
DB_NAME=line_queue
DB_USER=line_queue
DB_PASSWORD=replace-with-a-strong-database-password
# Set per API/worker process so the sum of all replicas stays below the
# PostgreSQL connection budget, leaving headroom for migrations and operators.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Backend-only shared ephemeral coordination. The default production Compose
# service is private and reachable as redis:6379; never use VITE_* for this URL.
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=sqa
REDIS_PUBLIC_BRANCH_CACHE_TTL_MS=5000
REDIS_PUBLIC_QUEUE_CACHE_TTL_MS=3000

# Transient SSE fan-out. Each stream reconnects periodically so auth sessions
# are revalidated; PostgreSQL/REST remain the recovery source.
SSE_KEEP_ALIVE_MS=15000
SSE_RETRY_MS=3000
SSE_MAX_CONNECTION_DURATION_MS=300000
SSE_MAX_CONNECTIONS=1000
SSE_MAX_CONNECTIONS_PER_USER=3

# LINE outbox delivery is owned exclusively by the dedicated BullMQ worker.
LINE_NOTIFICATION_DELIVERY_OWNER=bullmq
BULLMQ_STARTUP_TIMEOUT_MS=10000
BULLMQ_JOB_TIMEOUT_MS=300000
BULLMQ_WORKER_CONCURRENCY=1
BULLMQ_PROVIDER_RATE_LIMIT_MAX=20
BULLMQ_PROVIDER_RATE_LIMIT_DURATION_MS=1000
WORKER_HEALTH_FILE=/tmp/sqa-worker-health
WORKER_HEARTBEAT_INTERVAL_MS=10000

# API runtime.
NODE_ENV=production
SEED_ADMIN_PASSWORD=<strong-password>
API_PORT=4000
API_HOST=0.0.0.0

# Observability. OTEL_EXPORTER_OTLP_HEADERS and backend Sentry configuration
# stay server-only. Leave endpoints blank/disabled until collectors/projects exist.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=line-smart-queue-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
JWT_SECRET=replace-with-a-64-byte-random-secret
JWT_ACCESS_EXPIRES_IN=15m
AUTH_BUSINESS_IDLE_TIMEOUT_MINUTES=15
AUTH_BUSINESS_ABSOLUTE_TIMEOUT_HOURS=12
AUTH_CUSTOMER_SESSION_DAYS=30
AUTH_REFRESH_COOKIE_NAME=lq_refresh_session
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
AUTH_REVOKED_SESSION_RETENTION_DAYS=7

# LINE Login channel. Channel ID and LIFF ID are public identifiers. The current
# ID-token verification flow does not require LINE Login Channel Secret.
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
LINE_ID_TOKEN_VERIFICATION_MODE=line
# This LIFF ID must also be passed as VITE_LIFF_ID when building the web image.
# It is public configuration, but it is compiled into the image and cannot be
# changed by docker compose after the image has been pushed.
LINE_LOGIN_LIFF_ID=replace-with-liff-id
LINE_LIFF_ENDPOINT_PATH=/liff

# Frontend-only VITE_* values are intentionally omitted here. They are public
# build arguments compiled into the immutable web image. For production builds,
# use an empty VITE_API_URL, the same LIFF ID as above, /liff as the endpoint
# path, false for LIFF mock mode, and the selected public payment mode.

# Messaging API channel / Official Account. Keep both values only in this
# deployment file or the deployment platform's secret manager.
LINE_MESSAGING_CHANNEL_SECRET=replace-with-messaging-api-channel-secret
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=replace-with-messaging-api-channel-access-token
LINE_RICH_MENU_IMAGE_PATH=

# Durable LINE notification delivery.
LINE_NOTIFICATION_BATCH_SIZE=20
LINE_NOTIFICATION_WORKER_INTERVAL_MS=15000
LINE_NOTIFICATION_MAX_ATTEMPTS=5
LINE_NOTIFICATION_RETRY_BASE_SECONDS=30
LINE_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
LINE_NOTIFICATION_DISPATCH_CLAIM_TIMEOUT_SECONDS=60
LINE_MESSAGING_REQUEST_TIMEOUT_MS=10000

# Business account invitation and password reset email.
EMAIL_TRANSPORT=smtp
EMAIL_FROM_NAME=LINE Smart Queue Assistant
EMAIL_FROM_ADDRESS=no-reply@smartqueue.io.vn
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-app-password
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ACCOUNT_ACTIVATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_DELIVERY_BATCH_SIZE=20
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_PROCESSING_TIMEOUT_SECONDS=300

# Current deployment is a production-oriented demo. It processes no real money,
# requires no PAYOS_* credential, and never calls payOS while mode remains demo.
PAYMENT_MODE=demo
DEMO_PAYMENT_WEBHOOK_SECRET=replace-with-a-dedicated-random-secret
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENT_EXTERNAL_REDIRECT_BASE_URL=
# Set external only after merchant onboarding and provider acceptance. The API
# requires all three values at startup in external mode.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Inventory, location alerts, and forecasting workers.
INVENTORY_RESERVATION_TTL_MINUTES=1440
INVENTORY_EXPIRY_BATCH_SIZE=100
INVENTORY_EXPIRY_WORKER_INTERVAL_MS=60000
# google_routes requires a restricted backend Google Maps Platform key with
# Routes API and Geocoding API enabled. Keep mock when no billing account exists.
LOCATION_TRAVEL_PROVIDER=mock
GOOGLE_ROUTES_API_KEY=
LOCATION_TRAVEL_BUFFER_MINUTES=8
LOCATION_RETENTION_DAYS=30
LOCATION_ALERT_BATCH_SIZE=50
LOCATION_ALERT_MAX_ATTEMPTS=5
LOCATION_ALERT_CLAIM_TIMEOUT_SECONDS=900
LOCATION_CLEANUP_BATCH_SIZE=500
LOCATION_WORKER_INTERVAL_MS=60000
LOCATION_CLEANUP_INTERVAL_MS=3600000
FORECAST_RETENTION_DAYS=90
FORECAST_WORKER_INTERVAL_MS=3600000

# Forecasting currently uses measured PostgreSQL heuristics and does not call
# OpenAI or Gemini. Do not add an AI key until a reviewed provider adapter exists.

# ── Media Storage ─────────────────────────────────────────────

# Current production-oriented demo storage: local persistent storage in the
# production Compose media_data volume on the VPS. Never deploy local mode
# without the /app/var/media mount and never use `docker compose down -v` during rollout.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=/app/var/media
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_MAX_ORIGINAL_BYTES=5242880
MEDIA_REQUEST_BODY_LIMIT=8mb

# ── Backup and recovery (server-only, non-secret) ─────────────

# Runtime snapshots must use an absolute restricted directory outside the Git
# checkout. Replicate completed snapshots to encrypted off-host storage.
BACKUP_ROOT=/var/backups/line-smart-queue
BACKUP_RETENTION_COUNT=14

# ── S3-compatible Object Storage (optional) ───────────────────
# Enable when migrating media to AWS S3, Cloudflare R2,
# or another S3-compatible provider.
#
# To enable, change:
# MEDIA_STORAGE_PROVIDER=s3
#
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=false
