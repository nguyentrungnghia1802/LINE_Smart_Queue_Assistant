{
  "name": "line-smart-queue",
  "version": "0.0.1",
  "private": true,
  "description": "LINE Smart Queue Assistant — production-ready monorepo",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:worker": "npm run dev:worker --workspace=apps/api",
    "start:worker": "npm run start:worker --workspace=apps/api",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint playwright.config.ts e2e --ext .ts --max-warnings 0 && npm run lint --workspaces --if-present",
    "lint:fix": "eslint playwright.config.ts e2e --ext .ts --fix --max-warnings 0 && npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json && npm run typecheck --workspaces --if-present",
    "openapi:check": "npm run openapi:check -w apps/api",
    "e2e": "npm run build -w packages/shared && npm run build -w apps/api && playwright test --project=desktop-chromium",
    "e2e:all": "npm run build -w packages/shared && npm run build -w apps/api && playwright test",
    "e2e:install": "playwright install chromium",
    "spell:check": "cspell \"**/*.{ts,tsx,md}\" --no-progress --show-context",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "npm run build -w packages/shared && husky",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:d": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "docker:prod": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml up",
    "docker:prod:d": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d",
    "docker:prod:down": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml down",
    "docker:clean": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans",
    "media:persistence:verify": "node scripts/deployment/verify-local-media-persistence.mjs",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:migrate:down": "npm run db:migrate:down -w apps/api",
    "db:migrate:redo": "npm run db:migrate:redo -w apps/api",
    "db:migrate:status": "npm run db:migrate:status -w apps/api",
    "db:reset": "npm run db:reset:local",
    "db:reset:local": "node scripts/migrate.mjs reset && npm run db:migrate && npm run db:seed",
    "db:migrate:legacy": "node scripts/migrate.mjs legacy",
    "db:seed": "npm run db:seed -w apps/api",
    "db:seed:reset": "npm run db:seed:reset -w apps/api",
    "db:fixture:e2e": "npm run db:fixture:e2e -w apps/api",
    "line:verify": "npm run line:verify -w apps/api",
    "line:rich-menu:sync": "npm run line:rich-menu:sync -w apps/api",
    "storybook": "npm run storybook --workspace=apps/web",
    "storybook:build": "npm run storybook:build --workspace=apps/web",
    "scale:load": "node scripts/scalability/http-load.mjs",
    "scale:validate": "node scripts/scalability/integrated-validation.mjs",
    "scale:validate:config": "npm run test -w apps/api -- --runInBand src/config/__tests__/horizontal-validation.config.test.ts src/config/__tests__/database-pool.config.test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@line-queue/config": "*",
    "@playwright/test": "^1.61.1",
    "audit-ci": "^7.1.0",
    "cspell": "^8.9.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
