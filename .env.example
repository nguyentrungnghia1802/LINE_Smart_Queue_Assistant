# ══════════════════════════════════════════════════════════════════════════════
# LINE Smart Queue Assistant — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variable naming conventions:
#   DB_*       — PostgreSQL connection settings
#   API_*      — Express server configuration
#   JWT_*      — Auth token settings  (⚠️ backend-only, never expose)
#   LINE_*     — Backend LINE configuration; Messaging secrets stay server-only
#   VITE_*     — Frontend vars (⚠️ inlined into the browser bundle at Vite build time)
#   WEB_*      — Web container / nginx settings
#
# Docker Compose notes:
#   - docker-compose.yml (prod)    uses DB_PASSWORD with :? — it MUST be set
#   - docker-compose.dev.yml (dev) falls back to "dev_password" for convenience
#   - VITE_* are passed as build ARGs in docker-compose.yml; dev reads them at startup

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL is built dynamically by docker-compose from DB_* vars.
# Set it directly here only when connecting outside of docker-compose.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/line_queue
# Required only to run db:seed:*:reset against an isolated non-loopback development database.
ALLOW_DESTRUCTIVE_SEED_RESET=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=line_queue
DB_USER=postgres
# ⚠️ Required in production (docker-compose.yml fails fast if unset)
DB_PASSWORD=change_me

# Backend-only Redis coordination. Leave REDIS_URL empty for native local mode
# without Redis; Compose overrides it with the private redis service URL.
REDIS_URL=
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=sqa
REDIS_PUBLIC_BRANCH_CACHE_TTL_MS=5000
REDIS_PUBLIC_QUEUE_CACHE_TTL_MS=3000

# Dedicated BullMQ worker. Set to api only for bare local development without
# the worker process; Compose assigns bullmq to both API and worker explicitly.
LINE_NOTIFICATION_DELIVERY_OWNER=api
BULLMQ_STARTUP_TIMEOUT_MS=10000
BULLMQ_JOB_TIMEOUT_MS=300000
BULLMQ_WORKER_CONCURRENCY=1
BULLMQ_PROVIDER_RATE_LIMIT_MAX=20
BULLMQ_PROVIDER_RATE_LIMIT_DURATION_MS=1000
WORKER_HEALTH_FILE=/tmp/sqa-worker-health
WORKER_HEARTBEAT_INTERVAL_MS=10000

# ── API Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-bootstrap-password
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────────────────
# ⚠️ Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string
# Short-lived bearer token. Login duration is controlled by the server-side
# refresh session below, not by extending this token.
JWT_ACCESS_EXPIRES_IN=15m
# Admin, manager, and staff stay signed in while active. Their session expires
# after 15 idle minutes or 12 total hours, whichever happens first.
AUTH_BUSINESS_IDLE_TIMEOUT_MINUTES=15
AUTH_BUSINESS_ABSOLUTE_TIMEOUT_HOURS=12
# LINE customers can refresh their short access token for at most 30 days.
AUTH_CUSTOMER_SESSION_DAYS=30
AUTH_REFRESH_COOKIE_NAME=lq_refresh_session
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
AUTH_REVOKED_SESSION_RETENTION_DAYS=7

# ── LINE Login channel / LIFF ────────────────────────────────────────────────
# Public LINE Login channel ID used by the backend to verify LIFF OIDC ID tokens.
# The current ID-token verification flow does not use LINE Login Channel Secret.
LINE_LOGIN_CHANNEL_ID=
# Local/CI uses the paired web/API mock. Production deploy files must use `line`.
LINE_ID_TOKEN_VERIFICATION_MODE=mock
LINE_ID_TOKEN_MOCK_VALUE=mock-liff-id-token
LINE_ID_TOKEN_MOCK_USER_ID=mock-user-001
LINE_ID_TOKEN_MOCK_DISPLAY_NAME=Local LINE Customer

# ── LINE Messaging API channel / Official Account ───────────────────────────
# Messaging API channel secret and access token. These belong to the Official
# Account channel, not the LINE Login channel. Both are backend secrets.
LINE_MESSAGING_CHANNEL_SECRET=change_me
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# Durable LINE notification outbox worker. Non-secret operational tuning.
LINE_NOTIFICATION_BATCH_SIZE=20
LINE_NOTIFICATION_WORKER_INTERVAL_MS=15000
LINE_NOTIFICATION_MAX_ATTEMPTS=5
LINE_NOTIFICATION_RETRY_BASE_SECONDS=30
LINE_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
LINE_NOTIFICATION_DISPATCH_CLAIM_TIMEOUT_SECONDS=60
LINE_MESSAGING_REQUEST_TIMEOUT_MS=10000

# ── LIFF (LINE Front-end Framework) ─────────────────────────────────────────
# LIFF App ID from LINE Developers Console. This is embedded in the production
# web image as VITE_LIFF_ID, so it is safe to expose but must be set when the
# image is built. It must match LINE_LOGIN_LIFF_ID below.
VITE_LIFF_ID=
# Same LIFF App ID for backend-generated LINE notification deep links.
LINE_LOGIN_LIFF_ID=
# Path portion of the LIFF Endpoint URL configured in LINE Console.
VITE_LIFF_ENDPOINT_PATH=/liff
LINE_LIFF_ENDPOINT_PATH=/liff
# Optional PNG/JPEG image path used only by `npm run line:rich-menu:sync`.
# For production LINE sync, provide a real Rich Menu image that matches the definition size.
LINE_RICH_MENU_IMAGE_PATH=

# ── LIFF local development (mock mode) ───────────────────────────────────────
# Set VITE_LIFF_MOCK=true to bypass the real LINE SDK during local development.
# The mock adapter simulates LINE login so you can work without a real LIFF app.
VITE_LIFF_MOCK=true
VITE_LIFF_MOCK_LOGGED_IN=true
# VITE_LIFF_MOCK_USER_ID=mock-user-001
# VITE_LIFF_MOCK_DISPLAY_NAME=Dev User
# VITE_LIFF_MOCK_FRIEND=false
# VITE_LIFF_MOCK_PICTURE_URL=https://placehold.co/96x96/06c755/ffffff?text=DEV
# VITE_LIFF_MOCK_INIT_DELAY_MS=400

# ── Web / Frontend ───────────────────────────────────────────────────────────
# ⚠️ VITE_* vars are embedded into the JS bundle at build time.
#    They are visible to anyone who downloads your app. Never put secrets here.
# Production web builds use same-origin API access through nginx.
# Keep this empty because frontend requests already include the /api/v1 prefix.
# Native/dev Vite still proxies /api to the API process on port 4000.
VITE_API_URL=
VITE_APP_NAME=LINE Smart Queue Assistant
# Optional single-store demo fallback for LIFF Home. Keep empty in multi-organization
# production; organization QR links resolve their own public token dynamically.
VITE_LIFF_DEFAULT_BOOKING_PATH=
VITE_PAYMENT_MODE=demo
VITE_PAYMENT_REDIRECT_BASE_URL=

# ── Business account email (backend-only secrets) ───────────────────────────
# Use `mock` locally (HTML previews are written under var/email-preview).
# Set `smtp` in production after providing an SMTP account.
EMAIL_TRANSPORT=mock
EMAIL_FROM_NAME=LINE Smart Queue Assistant
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Generate at least 32 random characters. Changing this key invalidates pending
# encrypted email-outbox actions; never expose it through VITE_*.
EMAIL_TOKEN_ENCRYPTION_KEY=
ACCOUNT_ACTIVATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_DELIVERY_BATCH_SIZE=20
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_PROCESSING_TIMEOUT_SECONDS=300

# ── Payment provider foundation (backend-only) ───────────────────────────────
PAYMENT_MODE=demo
PAYMENT_EXTERNAL_REDIRECT_BASE_URL=
DEMO_PAYMENT_WEBHOOK_SECRET=change_me_to_a_random_demo_payment_secret
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# Backend-only payOS merchant credentials. Required only when PAYMENT_MODE=external
# and a branch selects payOS with VND. Never expose these as VITE_* variables.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Finite inventory reservations. Set TTL to 0 to disable automatic expiry.
INVENTORY_RESERVATION_TTL_MINUTES=1440
INVENTORY_EXPIRY_BATCH_SIZE=100
INVENTORY_EXPIRY_WORKER_INTERVAL_MS=60000

# Customers explicitly opt in to location sharing. The LIFF client watches location
# only while an active ticket exists. google_routes requires a restricted backend
# Google Maps Platform key with Routes API and Geocoding API enabled.
LOCATION_TRAVEL_PROVIDER=mock
GOOGLE_ROUTES_API_KEY=
LOCATION_TRAVEL_BUFFER_MINUTES=8
LOCATION_RETENTION_DAYS=30
LOCATION_ALERT_BATCH_SIZE=50
LOCATION_ALERT_MAX_ATTEMPTS=5
LOCATION_CLEANUP_BATCH_SIZE=500
LOCATION_WORKER_INTERVAL_MS=60000
LOCATION_CLEANUP_INTERVAL_MS=3600000

# Measured heuristic forecasting (no external AI service)
FORECAST_RETENTION_DAYS=90
FORECAST_WORKER_INTERVAL_MS=3600000

# Media storage. local/mock are implemented; real object storage remains an adapter boundary.
MEDIA_STORAGE_MODE=local
MEDIA_LOCAL_DIR=../../../../var/media
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_MAX_ORIGINAL_BYTES=5242880
MEDIA_REQUEST_BODY_LIMIT=8mb

# ── Web container (Docker) ───────────────────────────────────────────────────
WEB_PORT=80
# Used by docker-compose.yml for CORS_ORIGIN on the api service
WEB_ORIGIN=http://localhost:80

# Optional production image names used by docker-compose.prod.yml.
# Build the web image with an empty VITE_API_URL for same-origin deployment.
LINE_QUEUE_API_IMAGE=line-smart-queue-api:latest
LINE_QUEUE_WEB_IMAGE=line-smart-queue-web:latest

# ── Node.js debugger (dev only) ──────────────────────────────────────────────
# Port exposed by docker-compose.dev.yml for Node inspector
# Attach via VS Code "Node.js: Attach" launch config or chrome://inspect
NODE_INSPECTOR_PORT=9229
