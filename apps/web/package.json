{
  "name": "@line-queue/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "React + Vite frontend for LINE Smart Queue Assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-csp-bundle.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint src .storybook --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src .storybook --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@line-queue/shared": "*",
    "@line/liff": "^2.28.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.99.0",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.18.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@line-queue/config": "*",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.0",
    "rimraf": "^5.0.7",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.5",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
